<+><?xml version=\"1.0\" encoding=\"UTF-8\"?>\r\n<project version=\"4\">\r\n  <component name=\"DBNavigator.Project.DDLFileAttachmentManager\">\r\n    <mappings />\r\n    <preferences />\r\n  </component>\r\n  <component name=\"DBNavigator.Project.DataEditorManager\">\r\n    <record-view-column-sorting-type value=\"BY_INDEX\" />\r\n    <value-preview-text-wrapping value=\"false\" />\r\n    <value-preview-pinned value=\"false\" />\r\n  </component>\r\n  <component name=\"DBNavigator.Project.DatabaseAssistantManager\">\r\n    <assistants>\r\n      <assistant-state connection-id=\"8520747b-47c8-4662-8516-4a2660f9e785\" default-profile-name=\"\" selected-profile-name=\"\" selected-model-name=\"\" assistant-type=\"GENERIC\" selected-action=\"SHOW_SQL\" availability=\"UNAVAILABLE\" acknowledgement=\"NONE\">\r\n        <messages />\r\n      </assistant-state>\r\n      <assistant-state connection-id=\"45f288cf-a54f-4232-bd07-57c0b4d5d7dc\" default-profile-name=\"\" selected-profile-name=\"\" selected-model-name=\"\" assistant-type=\"GENERIC\" selected-action=\"SHOW_SQL\" availability=\"UNAVAILABLE\" acknowledgement=\"NONE\">\r\n        <messages />\r\n      </assistant-state>\r\n    </assistants>\r\n  </component>\r\n  <component name=\"DBNavigator.Project.DatabaseBrowserManager\">\r\n    <autoscroll-to-editor value=\"false\" />\r\n    <autoscroll-from-editor value=\"true\" />\r\n    <show-object-properties value=\"true\" />\r\n    <loaded-nodes />\r\n  </component>\r\n  <component name=\"DBNavigator.Project.DatabaseConsoleManager\">\r\n    <connection id=\"8520747b-47c8-4662-8516-4a2660f9e785\">\r\n      <console name=\"Connection\" type=\"STANDARD\" schema=\"information_schema\" session=\"Main\"><![CDATA[-- 1. Удаляем таблицы, если они существовали ранее\r\n--DROP TABLE IF EXISTS public.orders;\r\n--DROP TABLE IF EXISTS public.users;\r\n--\r\ndrop TABLE IF EXISTS public.orders CASCADE;\r\ndrop TABLE IF EXISTS public.users CASCADE;\r\n\r\n\r\n-- 2. Создаем таблицу пользователей \r\ncreate table public.users (\r\n    id serial primary key,                         \r\n    names varchar(100) not null,                    \r\n    email varchar(150) unique not null,            \r\n    status varchar(20) default 'active',           \r\n    created_at timestamp default current_timestamp \r\n);\r\n\r\n-- 3. Создаем таблицу заказов \r\ncreate table public.orders (\r\n    id serial primary key,                         \r\n    user_id int not null,                          \r\n    amount numeric(10, 5) not null,                \r\n    status varchar(20) default 'pending',          \r\n    created_at timestamp default current_timestamp, \r\n    \r\n    constraint fk_user foreign key (user_id) references public.users(id) on delete cascade\r\n);\r\n\r\n-- ==========================================\r\n-- НАПОЛНЕНИЕ ДАННЫМИ \r\n-- ==========================================\r\n\r\ninsert into public.users (names, email, status, created_at) values\r\n('Алексей Иванов', 'alex@example.com', 'active', now() - interval '10 days'),\r\n('Мария Петрова', 'maria@example.com', 'active', now() - interval '5 days'),\r\n('Иван Сидоров', 'ivan@example.com', 'suspended', now() - interval '1 day'),\r\n('Игорь Сидоров', 'igor@example.com', 'suspended', now() - interval '17 day'),\r\n('Коля Сидоров', 'in@test.com', 'suspended', now() - interval '10 day'),\r\n('Иван Васин', 'an@test.com', 'suspended', now() - interval '11 day');\r\n\r\ninsert into public.orders (user_id, amount, status, created_at) values\r\n(1, 1500.00, 'paid', now() - interval '9 days'),\r\n(1, 450.50, 'shipped', now() - interval '7 days'),\r\n(2, 3200.00, 'pending', now() - interval '3 days'),\r\n(2, 990.00, 'paid', now() - interval '2 days'),\r\n(3, 5000.00, 'cancelled', now() - interval '12 hours');\r\n\r\nselect * from public.users;\r\n\r\n-- Посмотреть все заказы\r\nselect * from public.orders;\r\n\r\n-- Объединенный запрос (Пользователи и их заказы)\r\nselect \r\n    u.id as user_id, \r\n    u.names, \r\n    o.id as order_id, \r\n    o.amount, \r\n    o.status as order_status\r\nfrom public.users u\r\nleft join public.orders o on u.id = o.user_id;\r\n\r\nselect \r\n    u.id as user_id, \r\n    u.names as user_name, \r\n    u.email,\r\n    o.id as order_id, \r\n    o.amount as order_amount, \r\n    o.status as order_status,\r\n    o.created_at as order_date\r\nfrom public.users u\r\nleft join public.orders o on u.id = o.user_id\r\norder by u.id, o.created_at desc;\r\n\r\n\r\nSELECT * FROM public.users WHERE email LIKE '%@test.com%';\r\n\r\n\r\nSELECT * FROM public.users \r\nWHERE status = 'active' AND created_at >= NOW() - INTERVAL '7 days';\r\n\r\n\r\nSELECT DISTINCT u.* FROM public.users u\r\nJOIN public.orders o ON u.id = o.user_id\r\nWHERE o.amount > 1000;\r\n\r\n\r\nBEGIN; -- Обязательно раскомментируйте BEGIN, если в конце стоит COMMIT!\r\n\r\nINSERT INTO public.users (names, email, status) \r\nVALUES ('Новый Юзер', 'new@test.com', 'active');\r\n\r\n-- LASTVAL() автоматически подставит ID только что сгенерированного юзера\r\nINSERT INTO public.orders (user_id, amount, status) \r\nVALUES (LASTVAL(), 2500.00, 'pending');\r\n\r\nCOMMIT;\r\n\r\n\r\n\r\nUPDATE public.orders \r\nSET status = 'completed' \r\nWHERE user_id = (SELECT id FROM public.users WHERE email = 'alex@example.com'); \r\n\r\n\r\n\r\nDELETE FROM public.users WHERE email LIKE '%@test%';\r\n\r\n\r\nSELECT table_name \r\nFROM information_schema.tables \r\nWHERE table_schema = 'public';\r\n\r\nCOMMIT;]]></console>\r\n      <console name=\"Connection 1\" type=\"STANDARD\" schema=\"postgres\" session=\"Main\"><![CDATA[-- 1. Удаляем таблицы, если они существовали ранее\r\nDROP TABLE IF EXISTS public.orders CASCADE;\r\nDROP TABLE IF EXISTS public.users CASCADE;\r\n\r\n-- 2. Создаем таблицу пользователей \r\nCREATE TABLE public.users (\r\n    id SERIAL PRIMARY KEY,                         \r\n    names VARCHAR(100) NOT NULL,                    \r\n    email VARCHAR(150) UNIQUE NOT NULL,            \r\n    status VARCHAR(20) DEFAULT 'active',           \r\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP \r\n);\r\n\r\n-- 3. Создаем таблицу заказов \r\nCREATE TABLE public.orders (\r\n    id SERIAL PRIMARY KEY,                         \r\n    user_id INT NOT NULL,                          \r\n    amount NUMERIC(10, 5) NOT NULL,                \r\n    status VARCHAR(20) DEFAULT 'pending',          \r\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, \r\n    CONSTRAINT fk_user FOREIGN KEY (user_id) REFERENCES public.users(id) ON DELETE CASCADE\r\n);\r\n\r\n-- ==========================================\r\n-- НАПОЛНЕНИЕ ДАННЫМИ \r\n-- ==========================================\r\n\r\nINSERT INTO public.users (names, email, status, created_at) VALUES\r\n('Алексей Иванов', 'alex@example.com', 'active', NOW() - INTERVAL '10 days'),\r\n('Мария Петрова', 'maria@example.com', 'active', NOW() - INTERVAL '5 days'),\r\n('Иван Сидоров', 'ivan@example.com', 'suspended', NOW() - INTERVAL '1 day'),\r\n('Игорь Сидоров', 'igor@example.com', 'suspended', NOW() - INTERVAL '17 day'),\r\n('Коля Сидоров', 'in@test.com', 'suspended', NOW() - INTERVAL '10 day'),\r\n('Иван Васин', 'an@test.com', 'suspended', NOW() - INTERVAL '11 day');\r\n\r\nINSERT INTO public.orders (user_id, amount, status, created_at) VALUES\r\n(1, 1500.00, 'paid', NOW() - INTERVAL '9 days'),\r\n(1, 450.50, 'shipped', NOW() - INTERVAL '7 days'),\r\n(2, 3200.00, 'pending', NOW() - INTERVAL '3 days'),\r\n(2, 990.00, 'paid', NOW() - INTERVAL '2 days'),\r\n(3, 5000.00, 'cancelled', NOW() - INTERVAL '12 hours');\r\n\r\n-- ==========================================\r\n-- ЗАПРОСЫ ПО ТРЕБОВАНИЯМ ЗАДАЧИ\r\n-- ==========================================\r\n\r\n-- Просмотр базовых таблиц\r\nSELECT * FROM public.users;\r\nSELECT * FROM public.orders;\r\n\r\n-- Найти пользователя по части почты (LIKE '%@test%')\r\nSELECT * FROM public.users WHERE email LIKE '%@test%';\r\n\r\n-- Вывести список активных пользователей, созданных за последнюю неделю\r\nSELECT * FROM public.users \r\nWHERE status = 'active' AND created_at >= NOW() - INTERVAL '7 days';\r\n\r\n-- Выбрать всех пользователей, у которых есть заказы на сумму > 1000 (JOIN)\r\nSELECT DISTINCT u.* FROM public.users u\r\nJOIN public.orders o ON u.id = o.user_id\r\nWHERE o.amount > 1000;\r\n\r\n-- Вставить нового пользователя и его заказ (в одной транзакции с фиксированием)\r\nBEGIN;\r\n\r\nINSERT INTO public.users (names, email, status) \r\nVALUES ('Новый Юзер', 'new@test.com', 'active');\r\n\r\nINSERT INTO public.orders (user_id, amount, status) \r\nVALUES (LASTVAL(), 2500.00, 'pending');\r\n\r\nCOMMIT;\r\n\r\n-- Обновить статус заказа по email пользователя (используем существующий alex@example.com)\r\nUPDATE public.orders \r\nSET status = 'completed' \r\nWHERE user_id = (SELECT id FROM public.users WHERE email = 'alex@example.com');\r\n\r\n-- Удалить тестовые данные по определённому признаку (содержат @test)\r\nDELETE FROM public.users WHERE email LIKE '%@test%';\r\n\r\n-- Проверка оставшихся таблиц в схеме public\r\nSELECT table_name \r\nFROM information_schema.tables \r\nWHERE table_schema = 'public';\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n-- 1. Удаляем таблицы, если они существовали ранее (для чистоты перезапуска)\r\n--DROP TABLE IF EXISTS orders;\r\n--DROP TABLE IF EXISTS users;\r\n\r\n-- 2. Создаем таблицу пользователей (users)\r\nCREATE TABLE users (\r\n    id SERIAL PRIMARY KEY,                         -- Автоинкрементный ID\r\n    named VARCHAR(100) NOT NULL,                    -- Имя пользователя\r\n    email VARCHAR(150) UNIQUE NOT NULL,            -- Уникальный email\r\n    status VARCHAR(20) DEFAULT 'active',           -- Статус (например: active, banned)\r\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP -- Дата регистрации\r\n);\r\n\r\n 3. Создаем таблицу заказов (orders)\r\nCREATE TABLE orders (\r\n    id SERIAL PRIMARY KEY,                         -- Автоинкрементный ID заказа\r\n    user_id INT NOT NULL,                          -- Ссылка на ID пользователя\r\n    amount NUMERIC(10, 2) NOT NULL,                -- Сумма заказа (например, 1250.50)\r\n    status VARCHAR(20) DEFAULT 'pending',          -- Статус заказа (pending, paid, shipped, cancelled)\r\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, -- Дата создания заказа\r\n\r\n    -- Внешний ключ: связываем order.user_id с users.id\r\n    -- При удалении пользователя удалятся и его заказы (ON DELETE CASCADE)\r\n    CONSTRAINT fk_user FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE\r\n);\r\n\r\n-- ==========================================\r\n-- НАПОЛНЕНИЕ ТЕСТОВЫМИ ДАННЫМИ\r\n-- ==========================================\r\n\r\n-- Вставляем пользователей (id сгенерируются автоматически: 1, 2, 3)\r\nINSERT INTO users (name, email, status, created_at) VALUES\r\n('Алексей Иванов', 'alex@example.com', 'active', NOW() - INTERVAL '10 days'),\r\n('Мария Петрова', 'maria@example.com', 'active', NOW() - INTERVAL '5 days'),\r\n('Иван Сидоров', 'ivan@example.com', 'suspended', NOW() - INTERVAL '1 day');\r\n\r\n-- Вставляем заказы для этих пользователей (user_id должен соответствовать существующим ID)\r\nINSERT INTO orders (user_id, amount, status, created_at) VALUES\r\n(1, 1500.00, 'paid', NOW() - INTERVAL '9 days'),\r\n(1, 450.50, 'shipped', NOW() - INTERVAL '7 days'),\r\n(2, 3200.00, 'pending', NOW() - INTERVAL '3 days'),\r\n(2, 990.00, 'paid', NOW() - INTERVAL '2 days'),\r\n(3, 5000.00, 'cancelled', NOW() - INTERVAL '12 hours');\r\n\r\n-- ==========================================\r\n-- ПРОВЕРКА ДАННЫХ (Выборка)\r\n-- ==========================================\r\n\r\n-- Посмотреть всех пользователей\r\nSELECT * FROM users;\r\n\r\n-- Посмотреть все заказы\r\nSELECT * FROM orders;\r\n\r\n-- Объединенный запрос (Пользователи и их заказы)\r\nSELECT \r\n    u.id AS user_id, \r\n    u.name, \r\n    o.id AS order_id, \r\n    o.amount, \r\n    o.status AS order_status\r\nFROM users u\r\nLEFT JOIN orders o ON u.id = o.user_id;]]></console>\r\n    </connection>\r\n    <connection id=\"45f288cf-a54f-4232-bd07-57c0b4d5d7dc\">\r\n      <console name=\"Connection 1\" type=\"STANDARD\" schema=\"postgres\" session=\"Main\" />\r\n    </connection>\r\n    <connection id=\"9e9ae870-afdf-453b-bc7e-aae233721056\">\r\n      <console name=\"Connection 2\" type=\"STANDARD\" schema=\"\" session=\"Main\" />\r\n    </connection>\r\n  </component>\r\n  <component name=\"DBNavigator.Project.DatabaseEditorStateManager\">\r\n    <last-used-providers />\r\n  </component>\r\n  <component name=\"DBNavigator.Project.DatabaseFileManager\">\r\n    <open-files>\r\n      <object connection-id=\"8520747b-47c8-4662-8516-4a2660f9e785\" object-ref=\"consoles/Connection\" />\r\n    </open-files>\r\n  </component>\r\n  <component name=\"DBNavigator.Project.DatabaseSessionManager\">\r\n    <connection id=\"8520747b-47c8-4662-8516-4a2660f9e785\" />\r\n    <connection id=\"45f288cf-a54f-4232-bd07-57c0b4d5d7dc\" />\r\n    <connection id=\"9e9ae870-afdf-453b-bc7e-aae233721056\" />\r\n  </component>\r\n  <component name=\"DBNavigator.Project.ExecutionManager\">\r\n    <retain-sticky-names value=\"false\" />\r\n  </component>\r\n  <component name=\"DBNavigator.Project.ObjectQuickFilterManager\">\r\n    <last-used-operator value=\"EQUAL\" />\r\n    <filters />\r\n  </component>\r\n  <component name=\"DBNavigator.Project.ScriptExecutionManager\" clear-outputs=\"true\">\r\n    <recently-used-interfaces />\r\n  </component>\r\n  <component name=\"DBNavigator.Project.Settings\">\r\n    <connections>\r\n      <connection id=\"8520747b-47c8-4662-8516-4a2660f9e785\" active=\"true\" signed=\"true\">\r\n        <database>\r\n          <name value=\"Connection\" />\r\n          <description value=\"\" />\r\n          <database-type value=\"POSTGRES\" />\r\n          <config-type value=\"BASIC\" />\r\n          <database-version value=\"18.6\" />\r\n          <driver-source value=\"BUNDLED\" />\r\n          <driver-library value=\"\" />\r\