//Вводные данные: вам пришла спецификация от команды бэкенда. Это урезанный OpenAPI (Swagger) JSON для эндпоинта
//POST /api/transfers (перевод средств между счетами). В ней описаны только базовые типы данных и единственный
//успешный сценарий.

{
  "openapi": "3.0.0",
  "info": {
    "title": "Core Banking API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/transfers": {
      "post": {
        "summary": "Создать новый перевод средств",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fromAccount": {
                    "type": "string",
                    "description": "Счет списания"
                  },
                  "toAccount": {
                    "type": "string",
                    "description": "Счет зачисления"
                  },
                  "amount": {
                    "type": "number",
                    "description": "Сумма перевода"
                  },
                  "currency": {
                    "type": "string",
                    "description": "Валюта (например, RUB, USD)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Перевод успешно выполнен",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transactionId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "example": "SUCCESS"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

